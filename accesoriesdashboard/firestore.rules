rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsIncomingVendor() {
      return signedIn() && request.resource.data.vendorId == request.auth.uid;
    }

    function ownsExistingVendor() {
      return signedIn() && resource.data.vendorId == request.auth.uid;
    }

    function ownsIncomingUser() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingUser() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsVendorDoc(vendorId) {
      return signedIn() && vendorId == request.auth.uid;
    }

    match /vendors/{vendorId} {
      allow read, create, update: if ownsVendorDoc(vendorId);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }

    match /product-collection/{productId} {
      allow create: if ownsIncomingVendor();
      allow read: if resource.data.status in ['published', 'active'] || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow update: if ownsExistingVendor()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inventory', 'stock', 'updatedAt'])
        );
      allow delete: if ownsExistingVendor();
    }

    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /product_attributes/{attributeId} {
      allow read: if true;
      allow write: if false;
    }

    match /cart/{cartId} {
      allow read, update, delete: if ownsExistingUser();
      allow create: if ownsIncomingUser();
    }

    match /wishlist/{wishlistId} {
      allow read, update, delete: if ownsExistingUser();
      allow create: if ownsIncomingUser();
    }

    match /orders/{orderId} {
      allow create: if ownsIncomingUser() && request.resource.data.vendorId is string;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow update: if signedIn() && resource.data.vendorId == request.auth.uid;
      allow delete: if false;
    }

    match /order_items/{itemId} {
      allow create: if ownsIncomingUser() && request.resource.data.vendorId is string;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow update, delete: if false;
    }

    match /inventory/{inventoryId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if ownsExistingVendor();
    }

    match /events/{eventId} {
      allow read: if resource.data.status == 'Published' || (signedIn() && resource.data.hostId == request.auth.uid);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'revenue', 'updatedAt']);
    }

    match /bookings/{bookingId} {
      allow create: if ownsIncomingUser();
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow update: if signedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if false;
    }

    match /eventRegistrations/{registrationId} {
      allow create: if ownsIncomingUser();
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow update: if signedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid);
      allow delete: if false;
    }

    match /{collectionName}/{docId} {
      allow create: if collectionName in [
        'product_variants',
        'brands',
        'warehouses',
        'coupons',
        'reviews',
        'analytics',
        'settlements',
        'withdrawals',
        'support_tickets',
        'media_library',
        'shipping_templates',
        'return_policies',
        'certifications',
        'bike_compatibility'
      ] && ownsIncomingVendor();

      allow read, update, delete: if collectionName in [
        'product_variants',
        'brands',
        'warehouses',
        'coupons',
        'reviews',
        'analytics',
        'settlements',
        'withdrawals',
        'support_tickets',
        'media_library',
        'shipping_templates',
        'return_policies',
        'certifications',
        'bike_compatibility'
      ] && ownsExistingVendor();
    }
  }
}
