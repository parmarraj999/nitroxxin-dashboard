rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Generated Ticket PDFs
    match /tickets/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Write permitted only by Cloud Functions via Firebase Admin
    }
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /events/{hostId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == hostId;
    }
  }
}
